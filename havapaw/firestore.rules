rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can read and write only their own data
    // (pets, geofences, collarData seed documents, fcmTokens, alerts, settings).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Collar readings are written by the ingestCollarData Cloud Function (admin SDK),
    // so the old unauthenticated "allow create: if true" rule is removed.

    // Per-device secret used by the collar to authenticate to ingestCollarData.
    // The app creates it during BLE provisioning; the token can never be read back
    // by a client, only by the Cloud Function.
    // Emergency mode records (one per contact), readable only by the owner.
    match /emergencyAlerts/{alertId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /deviceTokens/{deviceId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'petId', 'token', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() == 64;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() == 64;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
  }
}
